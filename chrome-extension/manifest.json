{
  "manifest_version": 3,
  "name": "Chrome Notification Guardian",
  "version": "1.0",
  "description": "Analyse toutes les notifications générées par les sites web dans Chrome.",

  "permissions": [
    "notifications",
    "storage"
  ],

  "host_permissions": [
    "http://localhost:8000/*",
    "<all_urls>"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],

  "action": {
    "default_popup": "popup.html",
    "default_title": "Notification Guardian"
  },

  "icons": {
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}