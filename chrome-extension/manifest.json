{
  "manifest_version": 3,
  "name": "Phishing Guardian - Auto Mail Detector",
  "version": "3.1",
  "description": "Détecte automatiquement les nouveaux mails Gmail/Yahoo et analyse le phishing avec IA",
  "permissions": [
    "notifications",
    "storage",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "https://mail.google.com/*",
    "http://localhost:8000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://mail.google.com/*",
        "https://*.mail.yahoo.com/*"
      ],
      "js": ["content_bridge.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Phishing Guardian"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["interceptor.js"],
      "matches": [
        "https://mail.google.com/*"
      ]
    }
  ]
}