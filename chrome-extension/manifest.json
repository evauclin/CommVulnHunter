{
  "manifest_version": 3,
  "name": "Guardian API (Gmail & Yahoo)",
  "version": "2.2",
  "description": "Analyse les notifications de Gmail et Yahoo avec une API.",
  "permissions": [
    "notifications",
    "storage",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "https://mail.google.com/*",
    "https://*.mail.yahoo.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://mail.google.com/*",
        "https://*.mail.yahoo.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "icons": {
    "48": "icons/icon48.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["interceptor.js"],
      "matches": [
        "https://mail.google.com/*",
        "https://*.mail.yahoo.com/*"
      ]
    }
  ]
}