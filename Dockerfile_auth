# Dockerfile pour le service d'authentification
FROM python:3.11-slim

# D�finir le r�pertoire de travail
WORKDIR /app

# Installer les d�pendances syst�me
RUN apt-get update && apt-get install -y \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copier et installer les d�pendances Python
COPY auth_system/requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

# Copier le syst�me d'authentification
COPY auth_system/ /app/auth_system/

# Copier le module gmail_fetcher pour la mise à jour des emails
RUN mkdir -p /app/src/utils
COPY src/utils/gmail_fetcher.py /app/src/utils/gmail_fetcher.py

# Cr�er le r�pertoire pour la base de donn�es
RUN mkdir -p /app/auth_system/data

# Exposer le port
EXPOSE 9000

# Variables d'environnement
ENV PYTHONPATH=/app
ENV PYTHONUNBUFFERED=1

# Commande de d�marrage
CMD ["python", "-m", "uvicorn", "auth_system.auth_api:auth_app", "--host", "0.0.0.0", "--port", "9000"]