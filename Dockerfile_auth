# Dockerfile pour le service d'authentification
FROM python:3.11-slim

# Définir le répertoire de travail
WORKDIR /app

# Installer les dépendances système
RUN apt-get update && apt-get install -y \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copier et installer les dépendances Python
COPY auth_system/requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

# Copier le système d'authentification
COPY auth_system/ /app/auth_system/

# Créer le répertoire pour la base de données
RUN mkdir -p /app/auth_system/data

# Exposer le port
EXPOSE 9000

# Variables d'environnement
ENV PYTHONPATH=/app
ENV PYTHONUNBUFFERED=1

# Commande de démarrage
CMD ["python", "-m", "uvicorn", "auth_system.auth_api:auth_app", "--host", "0.0.0.0", "--port", "9000"]